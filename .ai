│   │   ├── ShareMenu.svelte            # Share button + menu: Copy link / Copy as image (PNG via modern-screenshot)
│   │   ├── TweetMedia.svelte           # Twitter-style media grid (1 / 2 / 3 / 4 layouts, "+N" overflow; `size="quote"` for quote cards)
│   │   ├── MediaLightbox.svelte        # Full-screen image viewer (arrows/Escape, portaled to <body>)
│   │   ├── TweetAvatar.svelte          # Avatar image with initials fallback when the file is missing
│   │   ├── FeaturedTweet.svelte        # Wraps UserTweetDisplay with the "Featured" label and glow
│   │   ├── FeedNavigation.svelte       # Theme toggle, sort toggle, debounced search for the home feed
│   │   ├── Navigation.svelte           # Admin top nav (rendered by admin/+layout.svelte)
│   │   └── TweetCreator.svelte         # /admin/create: markdown editor, uploads, samples, live preview
│   ├── utils/
│   │   ├── engagement.ts               # randomEngagement(level): made-up low/medium/high counts
│   │   ├── markdownParser.ts           # TweetMarkdownParser: parse/generate bracket-tag markdown; slug + likes helpers
│   │   ├── twitterClipboardParser.ts   # Parses copied X HTML or archiver-script JSON; media download via /admin/media-proxy
│   │   ├── twitterTextParser.js        # Body text → safe HTML (entity decoding, links, hashtag/handle highlight)
│   │   ├── media.ts                    # getMediaUrl(), isVideo()
│   │   ├── tweetAdmin.ts               # deleteTweet(), deleteMediaFiles(), referencedMediaFiles()
│   │   └── featuredTweet.js            # Featured-tweet rotation: get/set/rotate, 30-day no-repeat history; TWEET_COLUMNS
│   ├── server/screenshotExtract.ts     # Claude vision call + JSON schema for the screenshot importer (server-only)
│   ├── server/feed.ts                  # Homepage feed query (fetchTweets), page size, public cache header
│   ├── types/tweet.ts                  # StoredTweet (a `tweets` row)
│   └── supabase.js                     # Anon-key Supabase client used by components/routes for data reads/writes
├── routes/
│   ├── +layout.svelte                  # Loads app.css
│   ├── +page.server.ts                 # Home: today's featured tweet (rotating if due) + first page, rendered with the HTML
│   ├── +page.svelte                    # Home feed: search, sort (newest/oldest/shuffle), featured tweet, infinite scroll via /api/tweets
│   ├── api/tweets/+server.ts           # GET feed pages: ?sort=&q=&cursor=&exclude=
│   ├── og/[slug]/+server.ts            # Link-preview image: square photos re-framed to 1200×630 (sharp), others passed through
│   ├── +error.svelte
│   ├── [slug]/
│   │   ├── +page.server.js             # Loads one tweet by slug + its newer/older neighbours' slugs
│   │   └── +page.svelte                # Public single-tweet view: floating card + back/prev/next (+ og/twitter link-preview tags)
│   └── admin/
│       ├── +layout.svelte              # .admin-shell light theme wrapper + Navigation
│       ├── +layout.server.js           # Redirects to /admin/login when there's no session (except the login page itself)
│       ├── +page.svelte                # Dashboard: counts, recent tweets, links
│       ├── login/, logout/             # Supabase email+password auth actions
│       ├── create/+page.svelte         # Uses TweetCreator
│       ├── parse/+page.svelte          # Import: paste copied X HTML or archiver JSON anywhere on the page
